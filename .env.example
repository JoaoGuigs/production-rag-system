# LLM — Google Gemini (grátis em aistudio.google.com/apikey)
GOOGLE_API_KEY=sua-chave-aqui
GOOGLE_MODEL=gemini-3.1-flash-lite

# Banco vetorial — Postgres + pgvector (suba com: make db)
DATABASE_URL=postgresql://postgres:rag@localhost:5433/rag
# true = busca no pgvector | false = índice em memória
USAR_PGVECTOR=false

# Embeddings (troque e rode make bench para comparar)
# MiniLM (384, leve) | mpnet (768) | bge-m3 (1024, melhor recall)
EMBEDDING_MODEL=BAAI/bge-m3
